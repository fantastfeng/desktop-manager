{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面管理",
  "version": "0.1.0",
  "identifier": "local.offline-desktop-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/OfflineDesktopManager/Icons/**",
          "$TEMP/OfflineDesktopManager/Icons/**"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "桌面收纳",
        "width": 360,
        "height": 460,
        "minWidth": 300,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true
      }
    ]
  }
}
